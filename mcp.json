{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "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"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/elicer/ARTI"
      ]
    },
    "sqlite": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "/home/elicer/ARTI/project.db"
      ]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres"
      ],
      "env": {
        "POSTGRES_CONNECTION_STRING": "postgresql://username:password@localhost:5432/arti_db"
      }
    },
    "jupyter": {
      "command": "python",
      "args": [
        "-m",
        "mcp_jupyter"
      ],
      "env": {
        "JUPYTER_KERNEL": "python3",
        "NOTEBOOK_DIR": "/home/elicer/ARTI/notebooks"
      }
    },
    "docker": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-docker"
      ]
    },
    "wandb": {
      "command": "python",
      "args": [
        "-m",
        "mcp_wandb"
      ],
      "env": {
        "WANDB_API_KEY": "your_wandb_api_key_here",
        "WANDB_PROJECT": "arti-sketch-generation"
      }
    },
    "aws-s3": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-aws-s3"
      ],
      "env": {
        "AWS_ACCESS_KEY_ID": "your_aws_access_key",
        "AWS_SECRET_ACCESS_KEY": "your_aws_secret_key",
        "AWS_REGION": "us-east-1",
        "S3_BUCKET": "arti-sketch-data"
      }
    },
    "google-cloud": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-gcp"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "/path/to/your/service-account-key.json",
        "GCP_PROJECT_ID": "your-gcp-project-id",
        "GCS_BUCKET": "arti-sketch-storage"
      }
    },
    "image-processing": {
      "command": "python",
      "args": [
        "-m",
        "mcp_image_processor"
      ],
      "env": {
        "IMAGE_CACHE_DIR": "/home/elicer/ARTI/art_outlines/cache",
        "THUMBNAIL_SIZE": "256",
        "SUPPORTED_FORMATS": "jpg,jpeg,png,webp,bmp,tif,tiff"
      }
    },
    "git-advanced": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git"
      ],
      "env": {
        "GIT_REPO_PATH": "/home/elicer/ARTI",
        "SUBMODULE_PATHS": "swiftsketch"
      }
    },
    "api-testing": {
      "command": "python",
      "args": [
        "-m",
        "mcp_api_tester"
      ],
      "env": {
        "BASE_URL": "http://localhost:8000",
        "TEST_DATA_DIR": "/home/elicer/ARTI/test_data",
        "LOAD_TEST_DURATION": "300"
      }
    },
    "model-registry": {
      "command": "python",
      "args": [
        "-m",
        "mcp_model_registry"
      ],
      "env": {
        "MODEL_STORAGE_PATH": "/home/elicer/ARTI/models",
        "ONNX_RUNTIME": "true",
        "TENSORRT_SUPPORT": "false"
      }
    },
    "metrics-collector": {
      "command": "python",
      "args": [
        "-m",
        "mcp_metrics"
      ],
      "env": {
        "PROMETHEUS_PORT": "9090",
        "GRAFANA_DASHBOARD": "true",
        "METRICS_DB": "/home/elicer/ARTI/metrics.db"
      }
    },
    "vector-search": {
      "command": "python",
      "args": [
        "-m",
        "mcp_vector_search"
      ],
      "env": {
        "EMBEDDING_MODEL": "clip-vit-base-patch32",
        "VECTOR_DB_PATH": "/home/elicer/ARTI/embeddings.db",
        "INDEX_TYPE": "faiss"
      }
    },
    "config-manager": {
      "command": "python",
      "args": [
        "-m",
        "mcp_config_manager"
      ],
      "env": {
        "CONFIG_DIR": "/home/elicer/ARTI/art_outlines/configs",
        "SCHEMA_VALIDATION": "true",
        "BACKUP_CONFIGS": "true"
      }
    }
  },
  "description": "MCP configuration for ARTI - Art Outline Generation System",
  "version": "1.0.0",
  "metadata": {
    "project": "ARTI",
    "description": "SwiftSketch-style vector sketch generation with Student model distillation",
    "requirements": [
      "Node.js (for npx-based MCPs)",
      "Python 3.10+ (for Python-based MCPs)",
      "Docker (for containerization)",
      "PostgreSQL (optional, for advanced database features)",
      "Cloud credentials (AWS/GCP, optional for cloud storage)"
    ],
    "setup_notes": [
      "Replace placeholder tokens and credentials with actual values",
      "Ensure all required directories exist before starting MCPs",
      "Install required Python packages: pip install mcp-jupyter mcp-wandb mcp-image-processor",
      "Some MCPs may require additional setup (Docker daemon, database servers, etc.)",
      "Create notebooks/ directory for Jupyter MCP: mkdir -p /home/elicer/ARTI/notebooks"
    ],
    "usage": {
      "development": [
        "github",
        "filesystem",
        "sqlite",
        "jupyter",
        "git-advanced",
        "config-manager"
      ],
      "training": [
        "wandb",
        "model-registry",
        "metrics-collector",
        "vector-search"
      ],
      "production": [
        "docker",
        "api-testing",
        "aws-s3",
        "image-processing"
      ]
    },
    "project_specific": {
      "teacher_generation": [
        "filesystem",
        "image-processing",
        "metrics-collector"
      ],
      "student_training": [
        "wandb",
        "model-registry",
        "jupyter",
        "vector-search"
      ],
      "serving_pipeline": [
        "docker",
        "api-testing",
        "aws-s3",
        "config-manager"
      ],
      "data_management": [
        "sqlite",
        "postgres",
        "vector-search",
        "image-processing"
      ]
    }
  }
}